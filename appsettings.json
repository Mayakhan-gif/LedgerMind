{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=LedgerMindDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "LedgerMind",
    "Audience": "LedgerMindUsers",
    "ExpiryMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Auth": {
    "AllowSelfRegistration": false
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "RefreshPermitLimit": 60,
    "RefreshWindowSeconds": 60,
    "ChatPermitLimit": 20,
    "ChatWindowSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Hangfire": {
    "Enabled": true,
    "DashboardEnabled": false
  },
  "DataProtection": {
    "KeysPath": "",
    "CertificatePath": ""
  },
  "Groq": {
    "BaseUrl": "https://api.groq.com/openai/v1/chat/completions",
    "Model": "llama-3.3-70b-versatile"
  },
  "Stripe": {
    "SuccessUrl": "http://localhost:5173/payment/success",
    "CancelUrl": "http://localhost:5173/payment/cancel",
    "CheckoutExpiryMinutes": 60
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 25,
    "UseStartTls": false,
    "FromName": "LedgerMind",
    "FromAddress": "noreply@ledgermind.local",
    "Username": ""
  },
  "Xero": {
    "RedirectUri": "https://localhost:7210/api/xero/callback",
    "Scopes": "openid profile email offline_access accounting.invoices.read accounting.contacts.read",
    "UseDemoData": false,
    "ReturnUrl": ""
  },
  "AllowedHosts": "*"
}
